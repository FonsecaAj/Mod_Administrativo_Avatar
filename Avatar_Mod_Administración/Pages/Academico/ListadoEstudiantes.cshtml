@page
@model Avatar_Mod_Administración.Pages.Academico.ListadoEstudiantesModel
@{
    ViewData["Title"] = "Listado de Estudiantes por Período";
}

<link rel="stylesheet" href="~/css/estudiantesmatri.css" />

<div class="estudiantesmatri-container">

    <!-- TÍTULO -->
    <div class="estudiantesmatri-header mb-4">
        <h1><i class="bi bi-people-fill"></i> Listado de Estudiantes por Período</h1>
    </div>

    <!-- FORMULARIO -->
    <form method="get" class="estudiantesmatri-form mb-4">
        <div class="row g-3 align-items-end">

            <div class="col-md-2">
                <label class="form-label">Período</label>
                <input asp-for="Periodo" type="number" class="form-control" placeholder="Ej: 1" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Carrera</label>
                <input asp-for="Carrera" type="text" class="form-control" placeholder="Ej: Tecnologías de la Información" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Curso</label>
                <input asp-for="Curso" type="text" class="form-control" placeholder="Ej: Programación I" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Grupo</label>
                <input asp-for="Grupo" type="text" class="form-control" placeholder="Ej: Programación I G1" />
            </div>

            <div class="col-md-1 d-grid">
                <button type="submit" class="btn-buscar">Buscar</button>
            </div>

        </div>
    </form>

    <!-- ALERTAS -->
    @if (Model.ErrorMessage != null)
    {
        <div class="alert-matri alert-danger">@Model.ErrorMessage</div>
    }
    else if (Model.Message != null)
    {
        <div class="alert-matri alert-info">@Model.Message</div>
    }

    @if (Model.Estudiantes != null && Model.Estudiantes.Any())
    {
        <!-- ACCIONES SUPERIORES -->
        <div class="estudiantesmatri-actions d-flex justify-content-between mb-2">
            <div>
                <button type="button" class="btn-export-csv btn-sm" onclick="exportarCSV()">📄 Exportar CSV</button>
                <button type="button" class="btn-export-pdf btn-sm" onclick="exportarPDF()">📕 Exportar PDF</button>
            </div>

            <div><strong>Total estudiantes:</strong> @Model.Estudiantes.Count()</div>
        </div>

        <!-- TABLA -->
        <div class="table-responsive estudiantesmatri-table-card">
            <table id="tablaEstudiantes" class="table table-estudiantesmatri">
                <thead>
                    <tr>
                        <th onclick="ordenarPor(0)">ID ⬍</th>
                        <th onclick="ordenarPor(1)">Tipo ⬍</th>
                        <th onclick="ordenarPor(2)">Identificación ⬍</th>
                        <th onclick="ordenarPor(3)">Nombre ⬍</th>
                        <th onclick="ordenarPor(4)">Carrera ⬍</th>
                        <th onclick="ordenarPor(5)">Curso ⬍</th>
                        <th onclick="ordenarPor(6)">Grupo ⬍</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Estudiantes)
                    {
                        if ((string.IsNullOrEmpty(Model.Carrera) || e.Carrera.Contains(Model.Carrera, StringComparison.OrdinalIgnoreCase)) &&
                            (string.IsNullOrEmpty(Model.Curso) || e.Curso.Contains(Model.Curso, StringComparison.OrdinalIgnoreCase)) &&
                            (string.IsNullOrEmpty(Model.Grupo) || e.Grupo.Contains(Model.Grupo, StringComparison.OrdinalIgnoreCase)))
                        {
                            <tr>
                                <td>@e.ID_Estudiante</td>
                                <td>@e.Tipo_Identificacion</td>
                                <td>@e.Identificacion</td>
                                <td>@e.Nombre_Completo</td>
                                <td>@e.Carrera</td>
                                <td>@e.Curso</td>
                                <td>@e.Grupo</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINACIÓN IGUAL A USUARIOS -->
        <nav aria-label="Paginación" class="mt-4 estudiantesmatri-pagination">
            <ul class="pagination justify-content-center mb-0">

                <li class="page-item">
                    <a class="page-link" href="#" id="btnAnterior">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </a>
                </li>

                <li class="page-item disabled">
                    <a class="page-link" href="#" id="paginaInfo">Página 1</a>
                </li>

                <li class="page-item">
                    <a class="page-link" href="#" id="btnSiguiente">
                        Siguiente <i class="bi bi-chevron-right"></i>
                    </a>
                </li>

            </ul>
        </nav>
    }
    else if (Model.Periodo != 0)
    {
        <div class="alert-matri alert-warning">No se encontraron registros para el período indicado.</div>
    }

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
        // ============================
        // Paginación y Ordenamiento
        // ============================
        let paginaActual = 1;
        const filasPorPagina = 10;
        let ordenColumna = -1;
        let ordenAsc = true;

        document.addEventListener("DOMContentLoaded", () => {
            mostrarPagina();
            document.getElementById("btnAnterior").addEventListener("click", anteriorPagina);
            document.getElementById("btnSiguiente").addEventListener("click", siguientePagina);
        });

        function mostrarPagina() {
            const filas = document.querySelectorAll("#tablaEstudiantes tbody tr");
            const totalFilas = filas.length;
            const totalPaginas = Math.ceil(totalFilas / filasPorPagina);

            filas.forEach((fila, i) => {
                fila.style.display = (i >= (paginaActual - 1) * filasPorPagina && i < paginaActual * filasPorPagina)
                    ? "" : "none";
            });

            document.getElementById("paginaInfo").innerText = `Página ${paginaActual} de ${totalPaginas}`;
            document.getElementById("btnAnterior").disabled = paginaActual === 1;
            document.getElementById("btnSiguiente").disabled = paginaActual === totalPaginas;
        }

        function siguientePagina() {
            const filas = document.querySelectorAll("#tablaEstudiantes tbody tr");
            const totalPaginas = Math.ceil(filas.length / filasPorPagina);
            if (paginaActual < totalPaginas) {
                paginaActual++;
                mostrarPagina();
            }
        }

        function anteriorPagina() {
            if (paginaActual > 1) {
                paginaActual--;
                mostrarPagina();
            }
        }

        function ordenarPor(indice) {
            const tabla = document.getElementById("tablaEstudiantes");
            const filas = Array.from(tabla.querySelectorAll("tbody tr"));
            const multiplicador = (ordenColumna === indice && ordenAsc) ? -1 : 1;
            ordenColumna = indice;
            ordenAsc = multiplicador === 1;

            filas.sort((a, b) => {
                const valorA = a.children[indice].innerText.toLowerCase();
                const valorB = b.children[indice].innerText.toLowerCase();
                return valorA.localeCompare(valorB, 'es') * multiplicador;
            });

            const cuerpo = tabla.querySelector("tbody");
            cuerpo.innerHTML = "";
            filas.forEach(f => cuerpo.appendChild(f));

            paginaActual = 1;
            mostrarPagina();
        }

        // ============================
        // Exportar CSV
        // ============================
        function exportarCSV() {
            const rows = [['ID', 'Tipo', 'Identificación', 'Nombre', 'Carrera', 'Curso', 'Grupo']];
            document.querySelectorAll('#tablaEstudiantes tbody tr').forEach(tr => {
                const cols = [...tr.children].map(td => td.innerText);
                rows.push(cols);
            });
            const csvContent = '\uFEFF' + rows.map(r => r.map(v => `"${v}"`).join(',')).join('\r\n');
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'ListadoEstudiantes.csv';
            link.click();
        }

        // ============================
        // Exportar PDF
        // ============================

        async function exportarPDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF("p", "mm", "a4");

            // Encabezado
            doc.setFontSize(18);
            doc.setFont("helvetica", "bold");
            doc.text('Listado de Estudiantes por Período', 14, 15);
            doc.setFontSize(12);
            doc.setFont("helvetica", "normal");
            doc.text('Reporte generado automáticamente', 14, 23);
            doc.line(14, 25, 196, 25);

            // Datos generales
            const periodo = document.querySelector('input[name="Periodo"]').value || 'No especificado';
            const carrera = document.querySelector('input[name="Carrera"]').value || 'Todas';
            const curso = document.querySelector('input[name="Curso"]').value || 'Todos';
            const grupo = document.querySelector('input[name="Grupo"]').value || 'Todos';
            const total = document.querySelectorAll('#tablaEstudiantes tbody tr').length;
            const fecha = new Date().toLocaleString('es-CR');

            let infoY = 33;
            doc.setFontSize(11);
            doc.setFont("helvetica", "bold");
            doc.text("Período:", 14, infoY);
            doc.text("Carrera:", 14, infoY + 7);
            doc.text("Curso:", 14, infoY + 14);
            doc.text("Grupo:", 14, infoY + 21);
            doc.text("Total Estudiantes:", 14, infoY + 28);
            doc.text("Fecha:", 14, infoY + 35);

            doc.setFont("helvetica", "normal");
            doc.text(periodo, 60, infoY);
            doc.text(carrera, 60, infoY + 7);
            doc.text(curso, 60, infoY + 14);
            doc.text(grupo, 60, infoY + 21);
            doc.text(String(total), 60, infoY + 28);
            doc.text(fecha, 60, infoY + 35);
            doc.line(14, infoY + 39, 196, infoY + 39);

            // Configuración de tabla con anchos adaptados
            const headers = ['ID', 'Tipo', 'Identificación', 'Nombre', 'Carrera', 'Curso', 'Grupo'];
            const colWidths = [10, 18, 28, 35, 38, 30, 25]; // más equilibrado
            const startX = 14;
            let y = infoY + 47;

            doc.setFontSize(10);
            doc.setFont("helvetica", "bold");
            headers.forEach((h, i) => {
                doc.text(h, startX + colWidths.slice(0, i).reduce((a, b) => a + b, 0), y);
            });

            doc.setFont("helvetica", "normal");
            y += 6;

            const filas = document.querySelectorAll('#tablaEstudiantes tbody tr');
            filas.forEach((tr, idx) => {
                const cols = [...tr.children].map(td => td.innerText);

                let maxAlturaFila = 6;
                cols.forEach((c, i) => {
                    const x = startX + colWidths.slice(0, i).reduce((a, b) => a + b, 0);
                    const texto = doc.splitTextToSize(String(c), colWidths[i] - 2); // salto de línea
                    doc.text(texto, x, y);
                    const altura = texto.length * 5.5;
                    if (altura > maxAlturaFila) maxAlturaFila = altura;
                });

                y += maxAlturaFila;
                if (y > 270 && idx < filas.length - 1) {
                    doc.addPage();
                    y = 20;
                }
            });

            // Pie de página
            const totalPages = doc.internal.getNumberOfPages();
            for (let i = 1; i <= totalPages; i++) {
                doc.setPage(i);
                doc.setFontSize(9);
                doc.text(`Página ${i} de ${totalPages}`, 105, 290, { align: "center" });
            }

            doc.save(`ListadoEstudiantes_P${periodo}.pdf`);
        }

    </script>
}
