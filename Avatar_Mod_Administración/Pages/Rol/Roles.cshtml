@page
@using Avatar_Mod_Administración.Entities
@model Avatar_Mod_Administración.Pages.Rol.RolesModel
@{
    ViewData["Title"] = "Administración de Roles";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item active'>Roles</li>";
}

@section Styles {
    <link rel="stylesheet" href="~/css/roles.css" asp-append-version="true" />
}

<div class="container roles-container">
    <!-- Header -->
    <div class="roles-header">
        <h2>
            <i class="bi bi-shield-lock"></i>
            Administración de Roles
        </h2>
        <a asp-page="/Rol/RolCrear" class="btn-crear-rol">
            <i class="bi bi-plus-circle"></i>
            Crear Rol
        </a>
    </div>

    <!-- Alertas -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show alert-rol" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>
                <strong>¡Éxito!</strong>
                <p class="mb-0">@TempData["Mensaje"]</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show alert-rol" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>Error</strong>
                <p class="mb-0">@TempData["Error"]</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla de Roles -->
    <div class="card roles-table-card">
        <div class="card-body">
            @if (Model.Roles.Count > 0)
            {
                <div class="mb-3 px-3 pt-3">
                    <span class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Mostrando <strong>@Model.Roles.Count</strong>
                        @(Model.Roles.Count == 1 ? "rol" : "roles")
                    </span>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover table-roles mb-0">
                    <thead>
                        <tr>
                            <th width="100">
                                <i class="bi bi-hash"></i>
                                ID
                            </th>
                            <th>
                                <i class="bi bi-person-badge"></i>
                                Nombre
                            </th>
                            <th>
                                <i class="bi bi-calendar-plus"></i>
                                Fecha Creación
                            </th>
                            <th>
                                <i class="bi bi-calendar-check"></i>
                                Última Modificación
                            </th>
                            <th class="text-end" width="150">
                                <i class="bi bi-gear"></i>
                                Acciones
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Roles.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="empty-state">
                                    <i class="bi bi-inbox"></i>
                                    <span class="text-muted">
                                        No se encontraron roles registrados
                                    </span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var rol in Model.Roles)
                            {
                                <tr>
                                    <td>
                                        <span class="badge-id">
                                            #@rol.IdRol
                                        </span>
                                    </td>
                                    <td>
                                        <strong>
                                            <i class="bi bi-shield-check text-muted me-2"></i>
                                            @rol.Nombre
                                        </strong>
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar-plus text-success me-1"></i>
                                        @rol.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (rol.FechaModificacion.HasValue)
                                        {
                                            <i class="bi bi-calendar-check text-warning me-1"></i>
                                            @rol.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <i class="bi bi-dash-circle me-1"></i>
                                                Sin modificaciones
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-page="/Rol/RolEditar"
                                               asp-route-id="@rol.IdRol"
                                               class="btn-action btn-warning"
                                               data-bs-toggle="tooltip"
                                               title="Editar rol">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn-action btn-danger"
                                                    onclick="RolesUtils.confirmarEliminacion(@rol.IdRol, '@rol.Nombre')"
                                                    data-bs-toggle="tooltip"
                                                    title="Eliminar rol">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Eliminación -->
<div class="modal fade modal-eliminar" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEliminarLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">
                    ¿Está seguro que desea eliminar el rol
                    <strong id="nombreEliminar"></strong>?
                </p>

                <div class="alert alert-warning alert-rol mb-3">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>
                        <strong>Importante:</strong> No se puede eliminar un rol si tiene usuarios asociados.
                    </div>
                </div>

                <p class="text-danger mb-0">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Esta acción no se puede deshacer.</strong>
                </p>
            </div>
            <div class="modal-footer">
                <form method="post" id="formEliminar">
                    <input type="hidden" name="id" id="idInput" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle"></i>
                            Cancelar
                        </button>
                        <button type="submit" asp-page-handler="Eliminar" class="btn btn-danger">
                            <i class="bi bi-trash-fill"></i>
                            Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/roles.js" asp-append-version="true"></script>
}