@page
@model Avatar_Mod_Administración.Pages.Institucion.InstitucionCrearModel
@{
    ViewData["Title"] = "Crear Institución";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item'><a href='/Institucion/Instituciones'>Instituciones</a></li><li class='breadcrumb-item active'>Crear Institución</li>";
}

@section Styles {
    <link rel="stylesheet" href="~/css/instituciones.css" asp-append-version="true" />
}

<div class="container instituciones-container">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <!-- Card Principal -->
            <div class="card institucion-form-card">
                <div class="card-header">
                    <h4>
                        <i class="bi bi-building-add"></i>
                        Crear Nueva Institución
                    </h4>
                </div>
                <div class="card-body">
                    <form method="post" class="institucion-form">
                        <!-- Errores de validación -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-institucion">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>
                                <strong>Error de validación</strong>
                                <p class="mb-0">Por favor, corrija los errores e intente nuevamente.</p>
                            </div>
                        </div>

                        <!-- Alerta informativa -->
                        <div class="alert alert-info alert-institucion">
                            <i class="bi bi-info-circle-fill"></i>
                            <div>
                                <strong>Importante:</strong>
                                El nombre de la institución debe ser único en el sistema.
                            </div>
                        </div>

                        <!-- Campo Nombre -->
                        <div class="mb-4">
                            <label asp-for="Input.Nombre" class="form-label">
                                <i class="bi bi-building"></i>
                                Nombre de la Institución
                                <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.Nombre"
                                   class="form-control"
                                   placeholder="Ej: Universidad de Costa Rica"
                                   maxlength="100"
                                   autofocus />
                            <div class="form-text">
                                <i class="bi bi-check-circle text-success"></i>
                                Solo letras y espacios (3-100 caracteres)
                            </div>
                            <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                        </div>

                        <!-- Nota de campos requeridos -->
                        <div class="mb-3">
                            <small class="text-muted">
                                <i class="bi bi-shield-check"></i>
                                Los campos marcados con <span class="text-danger fw-bold">*</span> son obligatorios
                            </small>
                        </div>

                        <!-- Botones de acción -->
                        <div class="form-actions">
                            <a asp-page="/Institucion/Instituciones" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i>
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i>
                                Crear Institución
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/instituciones.js" asp-append-version="true"></script>
}