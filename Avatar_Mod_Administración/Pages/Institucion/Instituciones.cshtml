@page
@using Avatar_Mod_Administración.Entities
@model Avatar_Mod_Administración.Pages.Institucion.InstitucionesModel
@{
    ViewData["Title"] = "Administración de Instituciones";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item active'>Instituciones</li>";
}

@section Styles {
    <link rel="stylesheet" href="~/css/instituciones.css" asp-append-version="true" />
}

<div class="container instituciones-container">
    <!-- Header -->
    <div class="instituciones-header">
        <h2>
            <i class="bi bi-building"></i>
            Administración de Instituciones
        </h2>
        <a asp-page="/Institucion/InstitucionCrear" class="btn-crear-institucion">
            <i class="bi bi-plus-circle"></i>
            Crear Institución
        </a>
    </div>

    <!-- Alertas -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show alert-institucion" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>
                <strong>¡Éxito!</strong>
                <p class="mb-0">@TempData["Mensaje"]</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show alert-institucion" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>Error</strong>
                <p class="mb-0">@TempData["Error"]</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Card de Búsqueda -->
    <div class="card search-card">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-10">
                    <label for="NombreBusqueda" class="form-label">
                        <i class="bi bi-search"></i>
                        Buscar por nombre
                    </label>
                    <input type="text"
                           class="form-control"
                           id="NombreBusqueda"
                           name="NombreBusqueda"
                           value="@Model.NombreBusqueda"
                           placeholder="Ingrese el nombre de la institución"
                           maxlength="100">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.NombreBusqueda))
            {
                <div class="mt-3 d-flex align-items-center gap-2">
                    <span class="search-badge">
                        <i class="bi bi-funnel-fill me-1"></i>
                        Filtrando por: "@Model.NombreBusqueda"
                    </span>
                    <a asp-page="/Institucion/Instituciones" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-circle"></i>
                        Limpiar búsqueda
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Tabla de Instituciones -->
    <div class="card instituciones-table-card">
        <div class="card-body">
            @if (Model.Instituciones.Count > 0)
            {
                <div class="mb-3 px-3 pt-3">
                    <span class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Mostrando <strong>@Model.Instituciones.Count</strong>
                        @(Model.Instituciones.Count == 1 ? "institución" : "instituciones")
                    </span>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover table-instituciones mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Fecha Creación</th>
                            <th>Última Modificación</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Instituciones.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="empty-state">
                                    <i class="bi bi-inbox"></i>
                                    <span class="text-muted">
                                        @if (!string.IsNullOrWhiteSpace(Model.NombreBusqueda))
                                        {
                                            <text>No se encontraron instituciones con el nombre "@Model.NombreBusqueda"</text>
                                        }
                                        else
                                        {
                                            <text>No se encontraron instituciones registradas</text>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var institucion in Model.Instituciones)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">#@institucion.IdInstitucion</span>
                                    </td>
                                    <td>
                                        <strong>@institucion.Nombre</strong>
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar-plus text-success me-1"></i>
                                        @institucion.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (institucion.FechaModificacion.HasValue)
                                        {
                                            <i class="bi bi-calendar-check text-warning me-1"></i>
                                            @institucion.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <i class="bi bi-dash-circle me-1"></i>Sin modificaciones
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (institucion.Activo)
                                        {
                                            <span class="badge-activo">
                                                <i class="bi bi-check-circle me-1"></i>Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-inactivo">
                                                <i class="bi bi-x-circle me-1"></i>Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-page="/Institucion/InstitucionEditar"
                                               asp-route-id="@institucion.IdInstitucion"
                                               class="btn-action btn-warning"
                                               data-bs-toggle="tooltip"
                                               title="Editar institución">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn-action btn-danger"
                                                    onclick="confirmarEliminacion(@institucion.IdInstitucion, '@institucion.Nombre')"
                                                    data-bs-toggle="tooltip"
                                                    title="Eliminar institución">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Eliminación -->
<div class="modal fade modal-eliminar" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEliminarLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">
                    ¿Está seguro que desea eliminar la institución
                    <strong id="nombreEliminar"></strong>?
                </p>

                <div class="alert alert-warning alert-institucion mb-3">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>
                        <strong>Importante:</strong> No se puede eliminar una institución si tiene carreras asociadas.
                    </div>
                </div>

                <p class="text-danger mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Esta acción no se puede deshacer.</strong>
                </p>
            </div>
            <div class="modal-footer">
                <form method="post" id="formEliminar" asp-page-handler="Eliminar">
                    <input type="hidden" name="id" id="idInput" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle"></i>
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash-fill"></i>
                            Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/instituciones.js" asp-append-version="true"></script>
}