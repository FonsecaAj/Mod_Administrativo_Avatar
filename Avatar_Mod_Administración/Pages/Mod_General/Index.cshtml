@page
@model Avatar_Mod_Administración.Pages.Mod_General.IndexModel
@{
    ViewData["Title"] = "Consulta de Bitácora";
}

<h2 class="mb-4">Bitácora del Sistema</h2>

<form method="get" class="card p-3 mb-4">
    <div class="row mb-3">
        <div class="col">
            <label>Fecha desde</label>
            <input type="date" name="FechaInicio"
                   class="form-control"
                   value="@Model.Filtro.FechaInicio?.ToString("yyyy-MM-dd")" />
        </div>

        <div class="col">
            <label>Fecha hasta</label>
            <input type="date" name="FechaFin"
                   class="form-control"
                   value="@Model.Filtro.FechaFin?.ToString("yyyy-MM-dd")" />
        </div>

        <div class="col">
            <label>Usuario</label>
            <input type="text" name="Usuario" class="form-control"
                   value="@Model.Filtro.Usuario" />
        </div>
    </div>

    <div class="row mb-3">

        <div class="col">
            <label>Acción</label>
            <select name="Accion" class="form-control">
                <option value="">-- Todas --</option>
                <option value="INSERT" selected="@(Model.Filtro.Accion == "INSERT")">INSERT</option>
                <option value="UPDATE" selected="@(Model.Filtro.Accion == "UPDATE")">UPDATE</option>
                <option value="DELETE" selected="@(Model.Filtro.Accion == "DELETE")">DELETE</option>
                <option value="SELECT" selected="@(Model.Filtro.Accion == "SELECT")">SELECT</option>
            </select>
        </div>

        <div class="col">
            <label>Módulo</label>
            <input type="text" name="Modulo" class="form-control"
                   value="@Model.Filtro.Modulo" />
        </div>

        <div class="col d-flex align-items-end">
            <button class="btn btn-primary w-100">Buscar</button>
        </div>
    </div>
</form>

@if (Model.Registros.Any())
{
    <div class="table-responsive">
        <table id="tablaBitacora" class="table table-striped">
            <thead>
                <tr>
                    <th onclick="ordenarPor(0)">ID ⬍</th>
                    <th onclick="ordenarPor(1)">Fecha ⬍</th>
                    <th onclick="ordenarPor(2)">Usuario ⬍</th>
                    <th onclick="ordenarPor(3)">Acción ⬍</th>
                    <th>Detalle</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var b in Model.Registros)
                {
                    <tr>
                        <td>@b.IdBitacora</td>
                        <td>@b.FechaBitacora</td>
                        <td>@b.Usuario</td>
                        <td>@b.Accion</td>

                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-secondary ver-json"
                                    data-json='@Html.Raw(Json.Serialize(b.JsonLimpio))'>
                                Ver JSON
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINACIÓN -->
    <nav aria-label="Paginación" class="mt-4">
        <ul class="pagination justify-content-center mb-0">

            <li class="page-item">
                <a class="page-link" href="#" id="btnAnterior">
                    <i class="bi bi-chevron-left"></i> Anterior
                </a>
            </li>

            <li class="page-item disabled">
                <a class="page-link" href="#" id="paginaInfo">Página 1</a>
            </li>

            <li class="page-item">
                <a class="page-link" href="#" id="btnSiguiente">
                    Siguiente <i class="bi bi-chevron-right"></i>
                </a>
            </li>

        </ul>
    </nav>
}
else
{
    <div class="alert alert-info">No hay registros.</div>
}

<!-- MODAL JSON -->
<div class="modal fade" id="modalJson" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Detalle JSON</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <pre id="jsonContent" class="bg-dark text-light p-3 rounded"></pre>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function mostrarDetalle(json) {
            document.getElementById("jsonContent").textContent =
                JSON.stringify(json, null, 2);

            new bootstrap.Modal(document.getElementById("modalJson")).show();
        }

        // ============================
        // Paginación y Ordenamiento
        // ============================
        let paginaActual = 1;
        const filasPorPagina = 10;
        let ordenColumna = -1;
        let ordenAsc = true;

        document.addEventListener("DOMContentLoaded", () => {
            mostrarPagina();
            document.getElementById("btnAnterior").addEventListener("click", anteriorPagina);
            document.getElementById("btnSiguiente").addEventListener("click", siguientePagina);
        });

        function mostrarPagina() {
            const filas = document.querySelectorAll("#tablaBitacora tbody tr");
            const totalFilas = filas.length;
            const totalPaginas = Math.ceil(totalFilas / filasPorPagina);

            filas.forEach((fila, i) => {
                fila.style.display =
                    (i >= (paginaActual - 1) * filasPorPagina && i < paginaActual * filasPorPagina)
                        ? "" : "none";
            });

            document.getElementById("paginaInfo").innerText = `Página ${paginaActual} de ${totalPaginas}`;
            document.getElementById("btnAnterior").classList.toggle("disabled", paginaActual === 1);
            document.getElementById("btnSiguiente").classList.toggle("disabled", paginaActual === totalPaginas);
        }

        function siguientePagina() {
            const filas = document.querySelectorAll("#tablaBitacora tbody tr");
            const totalPaginas = Math.ceil(filas.length / filasPorPagina);
            if (paginaActual < totalPaginas) {
                paginaActual++;
                mostrarPagina();
            }
        }

        function anteriorPagina() {
            if (paginaActual > 1) {
                paginaActual--;
                mostrarPagina();
            }
        }

        function ordenarPor(indice) {
            const tabla = document.getElementById("tablaBitacora");
            const filas = Array.from(tabla.querySelectorAll("tbody tr"));
            const multiplicador = (ordenColumna === indice && ordenAsc) ? -1 : 1;

            ordenColumna = indice;
            ordenAsc = multiplicador === 1;

            filas.sort((a, b) => {
                const valorA = a.children[indice].innerText.toLowerCase();
                const valorB = b.children[indice].innerText.toLowerCase();
                return valorA.localeCompare(valorB, 'es') * multiplicador;
            });

            const cuerpo = tabla.querySelector("tbody");
            cuerpo.innerHTML = "";
            filas.forEach(f => cuerpo.appendChild(f));

            paginaActual = 1;
            mostrarPagina();
        }

                document.addEventListener("click", e => {
            if (!e.target.classList.contains("ver-json")) return;

            const rawJson = e.target.getAttribute("data-json");

            try {
                const parsed = JSON.parse(rawJson);

                document.getElementById("jsonContent").textContent =
                    JSON.stringify(parsed, null, 2);
            } catch (err) {
                document.getElementById("jsonContent").textContent =
                    "JSON inválido:\n\n" + rawJson;
            }

            new bootstrap.Modal(document.getElementById("modalJson")).show();
        });
    </script>
}
