@page "{id:int}"
@model Avatar_Mod_Administración.Pages.ADM13_Grupo.EliminarModel
@{
    ViewData["Title"] = "Eliminar Grupo";
}

<h1>Eliminar Grupo</h1>

@if (Model.Grupo == null)
{
    <div class="alert alert-danger">Grupo no encontrado.</div>
    <a asp-page="Index" class="btn btn-secondary">Volver</a>
}
else
{
    <div class="alert alert-warning">
        ¿Seguro que desea eliminar el grupo
        <strong>@Model.Grupo.NumeroGrupo</strong>
        del curso <strong>@(Model.Grupo.CursoNombre ?? Model.Grupo.IdCurso.ToString())</strong>?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Curso</dt>
        <dd class="col-sm-9">@((Model.Grupo.CursoNombre) ?? Model.Grupo.IdCurso.ToString())</dd>

        <dt class="col-sm-3">Profesor</dt>
        <dd class="col-sm-9">@((Model.Grupo.ProfesorNombre) ?? Model.Grupo.IdProfesor.ToString())</dd>

        <dt class="col-sm-3">Periodo</dt>
        <dd class="col-sm-9">@((Model.Grupo.PeriodoNombre) ?? Model.Grupo.IdPeriodo.ToString())</dd>

        <dt class="col-sm-3">Horario</dt>
        <dd class="col-sm-9">@Model.Grupo.Horario</dd>
    </dl>

    <form method="post">
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
    </form>
}
