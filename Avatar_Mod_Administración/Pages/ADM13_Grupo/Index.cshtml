@page
@model Avatar_Mod_Administración.Pages.ADM13_Grupo.IndexModel
@{
    ViewData["Title"] = "Administrar Grupos";
}

<link rel="stylesheet" href="~/css/grupos.css" />
<!-- Incluir Font Awesome para los iconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="grupos-container">
    <div class="grupos-header">
        <h1>
            <i class="fas fa-users"></i>Administrar Grupos
        </h1>
        <a asp-page="Crear" class="btn-crear-grupo">
            <i class="fas fa-plus"></i>Nuevo Grupo
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-success alert-grupo">
            <i class="fas fa-check-circle"></i>@Model.Mensaje
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger alert-grupo">
            <i class="fas fa-exclamation-circle"></i>@Model.MensajeError
        </div>
    }

    <div class="grupos-table-card card">
        <div class="card-body">
            <table class="table table-grupos">
                <thead>
                    <tr>
                        <th>
                            <a href="#">
                                <i class="fas fa-hashtag me-1"></i>Número Grupo <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a href="#">
                                <i class="fas fa-book me-1"></i>Curso <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a href="#">
                                <i class="fas fa-chalkboard-teacher me-1"></i>Profesor <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a href="#">
                                <i class="fas fa-clock me-1"></i>Horario <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>
                            <a href="#">
                                <i class="fas fa-calendar-alt me-1"></i>Periodo <i class="fas fa-sort"></i>
                            </a>
                        </th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Grupos.Any())
                    {
                        foreach (var g in Model.Grupos)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary">Grupo @g.NumeroGrupo</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-book text-muted me-2"></i>
                                        <span>@(g.CursoNombre ?? g.IdCurso.ToString())</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-user-tie text-muted me-2"></i>
                                        <span>@(g.ProfesorNombre ?? g.IdProfesor.ToString())</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-clock text-muted me-2"></i>
                                        <span>@g.Horario</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-calendar text-muted me-2"></i>
                                        <span>@(g.PeriodoNombre ?? g.IdPeriodo.ToString())</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-page="Editar" asp-route-id="@g.IdGrupo"
                                           class="btn-action-grupo btn-warning me-1" data-bs-toggle="tooltip" title="Editar grupo">
                                            <i class="fas fa-edit"></i>Editar
                                        </a>
                                        <a asp-page="Eliminar" asp-route-id="@g.IdGrupo"
                                           class="btn-action-grupo btn-danger" data-bs-toggle="tooltip" title="Eliminar grupo">
                                            <i class="fas fa-trash"></i>Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">
                                <div class="empty-state">
                                    <i class="fas fa-users-slash"></i>
                                    <p class="text-muted">No hay grupos registrados</p>
                                    <a asp-page="Crear" class="btn-crear-grupo mt-3">
                                        <i class="fas fa-plus"></i>Crear Primer Grupo
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Inicializar tooltips de Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });

        // Animación para elementos que entran en vista
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.grupos-table-card');
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
            });
        });
    </script>
}