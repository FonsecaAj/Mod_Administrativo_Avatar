@page "{id:int}"
@model Avatar_Mod_Administración.Pages.ADM14_Prematricula.EditarModel
@{
    ViewData["Title"] = "Editar Prematrícula";
}

<h2>Editar Prematrícula</h2>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Prematricula.ID_Prematricula" />

    <div class="mb-3">
        <label class="form-label">ID Estudiante</label>
        <input asp-for="Prematricula.ID_Estudiante" class="form-control" />
        <span asp-validation-for="Prematricula.ID_Estudiante" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Carrera</label>
        <select asp-for="Prematricula.ID_Carrera" asp-items="Model.Carreras" class="form-select">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="Prematricula.ID_Carrera" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Curso</label>
        <select asp-for="Prematricula.ID_Curso" asp-items="Model.Cursos" class="form-select">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="Prematricula.ID_Curso" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Periodo</label>
        <select asp-for="Prematricula.ID_Periodo" asp-items="Model.Periodos" class="form-select">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="Prematricula.ID_Periodo" class="text-danger"></span>
    </div>


    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>
