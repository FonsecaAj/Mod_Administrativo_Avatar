@page
@model Avatar_Mod_Administración.Pages.ADM14_Prematricula.IndexModel
@{
    ViewData["Title"] = "Prematrículas";
}

<h2>Prematrículas</h2>

<form method="get" class="row g-3 mb-3">
    <div class="col-md-3">
        <label class="form-label">Periodo (solo futuros)</label>
        <select asp-for="Filtro.ID_Periodo" asp-items="Model.Periodos" class="form-select">
            <option value="">-- Todos --</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Carrera</label>
        <select asp-for="Filtro.ID_Carrera" asp-items="Model.Carreras" class="form-select">
            <option value="">-- Todas --</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Curso</label>
        <select asp-for="Filtro.ID_Curso" asp-items="Model.Cursos" class="form-select">
            <option value="">-- Todos --</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Estudiante (texto)</label>
        <input asp-for="Filtro.Estudiante" class="form-control" />
    </div>

    <div class="col-12 mt-2">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-page="Crear" class="btn btn-success">Nueva prematrícula</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
           
            <th>Estudiante</th>
            <th>Carrera</th>
            <th>Curso</th>
            <th>Periodo</th>
          
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Prematriculas)
        {
            <tr>
                <td>@p.NombreEstudiante</td>
                <td>@p.NombreCarrera</td>
                <td>@p.NombreCurso</td>
                <td>@p.NombrePeriodo</td>

                
                <td>
                    <a asp-page="Editar" asp-route-id="@p.ID_Prematricula" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-page="Eliminar" asp-route-id="@p.ID_Prematricula" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

