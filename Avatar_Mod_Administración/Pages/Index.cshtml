@page
@model Avatar_Mod_Administración.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<!-- Mensaje de bienvenida -->
<div class="row mb-4">
    <div class="col-12">
        <div class="alert alert-info d-flex align-items-center" role="alert">
            <i class="bi bi-person-circle me-3 fs-3"></i>
            <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <strong class="d-block mb-1">¡Bienvenido, @Model.UsuarioNombrePublic!</strong>
                        <small class="d-block">
                            <i class="bi bi-shield-check me-1"></i><strong>Rol:</strong> @Model.UsuarioRolPublic
                            <span class="mx-2">|</span>
                            <i class="bi bi-envelope me-1"></i><strong>Email:</strong> @Model.UsuarioEmailPublic
                        </small>
                    </div>
                    <div class="text-end">
                        <small class="text-muted d-block">
                            <i class="bi bi-clock me-1"></i>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mostrar errores -->
@if (TempData["Error"] != null)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<!-- Widgets según rol -->
<div class="row g-4">
    @if (Model.UsuarioRolPublic == "Administrador")
    {
        <!-- Widgets para Administrador -->
        <div class="col-lg-8">
            <div class="card quick-access-card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning-charge-fill me-2"></i>Accesos Rápidos
                    </h5>
                    <span class="badge bg-primary">Administrador</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a href="/Usuario/Usuarios" class="btn btn-outline-primary quick-access-btn w-100">
                                <i class="bi bi-people-fill fs-2 me-3"></i>
                                <div class="text-start flex-grow-1">
                                    <span class="fw-bold d-block">Usuarios</span>
                                    <small class="text-muted">@Model.TotalUsuarios usuarios</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="/Carrera/Carreras" class="btn btn-outline-warning quick-access-btn w-100">
                                <i class="bi bi-mortarboard-fill fs-2 me-3"></i>
                                <div class="text-start flex-grow-1">
                                    <span class="fw-bold d-block">Carreras</span>
                                    <small class="text-muted">@Model.TotalCarreras carreras</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="/ADM10_Cursos" class="btn btn-outline-info quick-access-btn w-100">
                                <i class="bi bi-book-fill fs-2 me-3"></i>
                                <div class="text-start flex-grow-1">
                                    <span class="fw-bold d-block">Cursos</span>
                                    <small class="text-muted">@Model.TotalCursos cursos</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="/ADM12_Periodo" class="btn btn-outline-success quick-access-btn w-100">
                                <i class="bi bi-calendar-range-fill fs-2 me-3"></i>
                                <div class="text-start flex-grow-1">
                                    <span class="fw-bold d-block">Períodos</span>
                                    <small class="text-muted">@Model.TotalPeriodosActivos activos</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Widget de Facturas Pendientes -->
            <div class="card info-card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>Facturas Pendientes
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h3 class="mb-0 fw-bold text-danger">@Model.TotalFacturasPendientes</h3>
                            <small class="text-muted">Últimos 3 meses</small>
                        </div>
                        <i class="bi bi-exclamation-triangle-fill fs-1 text-danger opacity-25"></i>
                    </div>
                    @if (Model.TotalFacturasPendientes > 0)
                    {
                        <a href="/Facturacion/Facturas" class="btn btn-sm btn-outline-danger w-100">
                            <i class="bi bi-arrow-right me-1"></i> Ver facturas pendientes
                        </a>
                    }
                    else
                    {
                        <div class="text-center text-success">
                            <i class="bi bi-check-circle me-1"></i> No hay facturas pendientes
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card help-card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-gear-fill me-2"></i>Herramientas
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/ADM11_Profesor" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-people me-2"></i>Profesores
                        </a>
                        <a href="/ADM13_Grupo" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-diagram-3 me-2"></i>Grupos
                        </a>
                        <a href="/ADM14_Prematricula" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-clipboard-check me-2"></i>Prematrícula
                        </a>
                        <a href="/Institucion/Instituciones" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-building me-2"></i>Instituciones
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (Model.UsuarioRolPublic == "Profesor")
    {
        <!-- Widgets para Profesor -->
        <div class="col-lg-8">
            <div class="card quick-access-card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning-charge-fill me-2"></i>Mi Panel de Trabajo
                    </h5>
                    <span class="badge bg-primary">Profesor</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Widget 1: Mis Grupos (ahora con enlace) -->
                        <div class="col-md-4">
                            <a href="/ADM13_Grupo" class="text-decoration-none">
                                <div class="card border-primary">
                                    <div class="card-body text-center">
                                        <i class="bi bi-diagram-3-fill fs-1 text-primary mb-2"></i>
                                        <h3 class="mb-0 fw-bold">@Model.TotalGruposAsignados</h3>
                                        <p class="text-muted mb-0">Mis Grupos</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <!-- Widget 2: Cursos que Imparto (ahora con enlace) -->
                        <div class="col-md-4">
                            <a href="/ADM10_Cursos" class="text-decoration-none">
                                <div class="card border-info">
                                    <div class="card-body text-center">
                                        <i class="bi bi-book-fill fs-1 text-info mb-2"></i>
                                        <h3 class="mb-0 fw-bold">@Model.TotalCursosImpartidos</h3>
                                        <p class="text-muted mb-0">Cursos que Imparto</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <!-- Widget 3: Desglose y Notas (nuevo) -->
                        <div class="col-md-4">
                            <a href="/Notas/Index" class="text-decoration-none">
                                <div class="card border-success">
                                    <div class="card-body text-center">
                                        <i class="bi bi-clipboard-data-fill fs-1 text-success mb-2"></i>
                                        <h3 class="mb-0 fw-bold"><i class="bi bi-pencil-square"></i></h3>
                                        <p class="text-muted mb-0">Desglose y Notas</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.PeriodoActual))
            {
                <div class="card info-card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-calendar-check me-2"></i>Período Actual
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-2">
                            <strong>Período:</strong> <span class="text-primary">@Model.PeriodoActual</span>
                        </p>
                        @if (Model.PeriodoFechaInicio.HasValue && Model.PeriodoFechaFin.HasValue)
                        {
                            <p class="mb-2">
                                <strong>Inicio:</strong> @Model.PeriodoFechaInicio.Value.ToString("dd/MM/yyyy") |
                                <strong>Fin:</strong> @Model.PeriodoFechaFin.Value.ToString("dd/MM/yyyy")
                            </p>
                            <div class="progress mb-2" style="height: 8px;">
                                <div class="progress-bar" role="progressbar" style="width: @Model.PorcentajePeriodo%;"
                                     aria-valuenow="@Model.PorcentajePeriodo" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <small class="text-muted">@Model.PorcentajePeriodo% completado</small>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card info-card">
                    <div class="card-body text-center text-muted">
                        <i class="bi bi-info-circle fs-1 mb-2"></i>
                        <p class="mb-0">No hay período académico activo</p>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card help-card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-tools me-2"></i>Recursos
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/Academico/ListadoEstudiantes" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-people me-2"></i>Mis Estudiantes
                        </a>
                        <a href="/Academico/HistorialAcademico" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-journal-text me-2"></i>Historial Académico
                        </a>
                        <a href="/Ayuda/Index" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-book me-2"></i>Ayuda
                        </a>
                        <a href="/Soporte/Index" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-headset me-2"></i>Soporte
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Widgets para otros roles -->
        <div class="col-lg-8">
            <div class="card info-card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>Información del Sistema
                    </h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">
                        <strong>Sistema Avatar</strong> - Plataforma de gestión académica
                    </p>
                    <p class="mb-2">
                        Bienvenido al sistema de gestión académica. Utiliza el menú lateral para acceder a las funcionalidades disponibles.
                    </p>
                    <p class="mb-0 text-muted">
                        <i class="bi bi-calendar3 me-2"></i>
                        Sesión iniciada: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card help-card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-question-circle me-2"></i>Ayuda
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/Ayuda/Index" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-book me-2"></i>Manual de Usuario
                        </a>
                        <a href="/Soporte/Index" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-headset me-2"></i>Soporte Técnico
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Panel de Actividad Reciente -->
<div class="row g-4 mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-clock-history me-2"></i>Actividad Reciente del Sistema
                </h5>
                <span class="badge bg-secondary">Últimos 20 registros</span>
            </div>
            <div class="card-body">
                <!-- Loading inicial -->
                <div id="loading-actividades" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-3 text-muted">Cargando actividades...</p>
                </div>

                <!-- Contenido dinámico -->
                <div id="actividades-container" style="display: none;">
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="notif-tab" data-bs-toggle="tab"
                                    data-bs-target="#notif-panel" type="button">
                                <i class="bi bi-envelope me-1"></i>Notificaciones
                                <span class="badge bg-success ms-1" id="count-notif">0</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="bitacora-tab" data-bs-toggle="tab"
                                    data-bs-target="#bitacora-panel" type="button">
                                <i class="bi bi-journal-text me-1"></i>Bitácoras
                                <span class="badge bg-info ms-1" id="count-bitacora">0</span>
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <!-- Tab: Notificaciones -->
                        <div class="tab-pane fade show active" id="notif-panel">
                            <div id="lista-notificaciones"></div>
                        </div>

                        <!-- Tab: Bitácoras -->
                        <div class="tab-pane fade" id="bitacora-panel">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 15%">Fecha</th>
                                            <th style="width: 20%">Usuario</th>
                                            <th style="width: 20%">Acción</th>
                                            <th style="width: 45%">Descripción</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tabla-bitacoras"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Empty state -->
                <div id="empty-actividades" style="display: none;" class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 mb-3 d-block opacity-50"></i>
                    <p class="mb-0">No hay actividad registrada</p>
                </div>

                <!-- Error state -->
                <div id="error-actividades" style="display: none;" class="text-center py-5 text-danger">
                    <i class="bi bi-exclamation-triangle fs-1 mb-3 d-block opacity-50"></i>
                    <p class="mb-0">Error al cargar actividades</p>
                    <button class="btn btn-sm btn-outline-primary mt-3" onclick="cargarActividades()">
                        <i class="bi bi-arrow-clockwise me-1"></i>Reintentar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}