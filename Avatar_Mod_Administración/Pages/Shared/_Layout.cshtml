@using Avatar_Mod_Administración.Services
@inject IAuthService AuthService
@{
    var sesion = AuthService.ObtenerSesionActual();

    var usuarioNombre = ViewData["UsuarioNombre"]?.ToString() ?? "Usuario";
    var usuarioRol = ViewData["UsuarioRol"]?.ToString() ?? "Invitado";
    var usuarioRolId = ViewData["UsuarioRolId"]?.ToString() ?? "0";
    var usuarioID = ViewData["UsuarioID"]?.ToString() ?? sesion?.UsuarioID ?? "";

    var accessToken = sesion?.AccessToken ?? "";

    if (!string.IsNullOrEmpty(accessToken) && !accessToken.StartsWith("Bearer "))
    {
        accessToken = $"Bearer {accessToken}";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Avatar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Contenedor con data attributes -->
    <div id="app-data"
         data-usuario-nombre="@usuarioNombre"
         data-usuario-rol="@usuarioRol"
         data-usuario-rol-id="@usuarioRolId"
         data-usuario-id="@usuarioID"
         data-access-token="@accessToken"
         style="display: none;">
    </div>

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <i class="bi bi-mortarboard-fill"></i>
                <span class="logo-text">Sistema Avatar</span>
            </div>
            <button class="btn-collapse">
                <i class="bi bi-chevron-left"></i>
            </button>
        </div>

        <!-- Navegación dinámica -->
        <nav class="sidebar-nav">
            <div class="text-center py-4" id="menu-loader">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <div class="small text-muted mt-2">Cargando menú...</div>
            </div>
        </nav>

        <div class="sidebar-footer">
            <small class="text-muted">© 2024 Universidad CUC</small>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="navbar-left">
                <button class="btn-menu-toggle">
                    <i class="bi bi-list"></i>
                </button>

                <!-- Breadcrumbs dinámicos -->
                <nav aria-label="breadcrumb" class="breadcrumb-container">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i> Inicio</a></li>
                    </ol>
                </nav>
            </div>

            <div class="navbar-right">
                <!-- Menú de Usuario con Dropdown -->
                <div class="dropdown">
                    <button class="btn-user-menu dropdown-toggle" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="user-info">
                            <div class="user-name">@usuarioNombre</div>
                            <small class="user-role">@usuarioRol</small>
                        </div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="userMenuDropdown">
                        <li class="dropdown-header">
                            <div class="d-flex align-items-center">
                                <div class="user-avatar-small me-2">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">@usuarioNombre</div>
                                    <small class="text-muted">@usuarioRol</small>
                                </div>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="/Perfil/Index">
                                <i class="bi bi-person-circle me-2"></i>
                                Mi Perfil
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" asp-page="/Index" asp-page-handler="Logout" class="m-0">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Cerrar Sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="page-content">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="page-footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-0 text-muted">
                            <i class="bi bi-mortarboard me-1"></i>
                            Sistema Avatar - Universidad CUC
                        </p>
                    </div>
                    <div class="col-md-6 text-end">
                        <p class="mb-0 text-muted">
                            <i class="bi bi-person-badge me-1"></i>
                            <span id="footer-user-info">@usuarioNombre (@usuarioRol)</span>
                        </p>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Toast Container para notificaciones -->
    <div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer"></div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/menu-dinamico.js" asp-append-version="true"></script>
    <script src="~/js/bitacora-client.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>