@page
@model Avatar_Mod_Administración.Pages.Modulo.ModulosModel
@{
    ViewData["Title"] = "Administración de Módulos";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item active'>Módulos</li>";
}

@section Styles {
    <link rel="stylesheet" href="~/css/modulos.css" asp-append-version="true" />
}

<div class="container modulos-container">
    <!-- Header -->
    <div class="modulos-header">
        <h2>
            <i class="bi bi-puzzle"></i>
            Administración de Módulos
        </h2>
        <a asp-page="/Modulo/ModuloCrear" class="btn-crear-modulo">
            <i class="bi bi-plus-circle"></i>
            Crear Módulo
        </a>
    </div>

    <!-- Alertas -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show alert-modulo" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>
                <strong>¡Éxito!</strong>
                <p class="mb-0">@TempData["Mensaje"]</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show alert-modulo" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>Error</strong>
                <p class="mb-0">@TempData["Error"]</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Card de Búsqueda -->
    <div class="card search-card">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-10">
                    <label for="NombreBusqueda" class="form-label">
                        <i class="bi bi-search"></i>
                        Buscar por nombre
                    </label>
                    <input type="text"
                           class="form-control"
                           id="NombreBusqueda"
                           name="NombreBusqueda"
                           value="@Model.NombreBusqueda"
                           placeholder="Ingrese el nombre del módulo"
                           maxlength="100">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.NombreBusqueda))
            {
                <div class="mt-3 d-flex align-items-center gap-2">
                    <span class="search-badge">
                        <i class="bi bi-funnel-fill me-1"></i>
                        Filtrando por: "@Model.NombreBusqueda"
                    </span>
                    <a asp-page="/Modulo/Modulos" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-circle"></i>
                        Limpiar búsqueda
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Tabla de Módulos -->
    <div class="card modulos-table-card">
        <div class="card-body">
            @if (Model.Modulos.Count > 0)
            {
                <div class="mb-3 px-3 pt-3">
                    <span class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Mostrando <strong>@Model.Modulos.Count</strong>
                        @(Model.Modulos.Count == 1 ? "módulo" : "módulos")
                    </span>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover table-modulos mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Orden</th>
                            <th>Nombre</th>
                            <th>Fecha Creación</th>
                            <th>Última Modificación</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Modulos.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="empty-state">
                                    <i class="bi bi-inbox"></i>
                                    <span class="text-muted">
                                        @if (!string.IsNullOrWhiteSpace(Model.NombreBusqueda))
                                        {
                                            <text>No se encontraron módulos con el nombre "@Model.NombreBusqueda"</text>
                                        }
                                        else
                                        {
                                            <text>No se encontraron módulos registrados</text>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var modulo in Model.Modulos)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">#@modulo.IdModulo</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@modulo.Orden</span>
                                    </td>
                                    <td>
                                        <strong>@modulo.Nombre</strong>
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar-plus text-success me-1"></i>
                                        @modulo.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (modulo.FechaModificacion.HasValue)
                                        {
                                            <i class="bi bi-calendar-check text-warning me-1"></i>
                                            @modulo.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <i class="bi bi-dash-circle me-1"></i>Sin modificaciones
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (modulo.Activo)
                                        {
                                            <span class="badge-activo">
                                                <i class="bi bi-check-circle me-1"></i>Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-inactivo">
                                                <i class="bi bi-x-circle me-1"></i>Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-page="/Modulo/ModuloEditar"
                                               asp-route-id="@modulo.IdModulo"
                                               class="btn-action btn-warning"
                                               data-bs-toggle="tooltip"
                                               title="Editar módulo">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn-action btn-danger"
                                                    onclick="confirmarEliminacion(@modulo.IdModulo, '@modulo.Nombre')"
                                                    data-bs-toggle="tooltip"
                                                    title="Eliminar módulo">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Eliminación -->
<div class="modal fade modal-eliminar" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEliminarLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">
                    ¿Está seguro que desea eliminar el módulo
                    <strong id="nombreEliminar"></strong>?
                </p>

                <p class="text-danger mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Esta acción no se puede deshacer.</strong>
                </p>
            </div>
            <div class="modal-footer">
                <form method="post" id="formEliminar">
                    <input type="hidden" name="id" id="idInput" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle"></i>
                            Cancelar
                        </button>
                        <button type="submit" asp-page-handler="Eliminar" class="btn btn-danger">
                            <i class="bi bi-trash-fill"></i>
                            Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modulos.js" asp-append-version="true"></script>
}