@page
@model Avatar_Mod_Administración.Pages.ADM11_Profesor.IndexModel
@{
    ViewData["Title"] = "Administrar Profesores";
}

<h1 class="mb-4">Administrar Profesores</h1>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success">@Model.Mensaje</div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

<form method="get" class="row g-3 mb-3">
    <div class="col-md-4">
        <label class="form-label">Buscar por:</label>
        <select class="form-select" name="BuscarPor">
            <option value="Todos" selected="@(Model.BuscarPor == "Todos")">Todos</option>
            <option value="Identificacion" selected="@(Model.BuscarPor == "Identificacion")">Identificación</option>
            <option value="Nombre" selected="@(Model.BuscarPor == "Nombre")">Nombre</option>
            <option value="Email" selected="@(Model.BuscarPor == "Email")">Email</option>
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Profesor a buscar</label>
        <input class="form-control" name="Texto" value="@Model.Texto" />
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Buscar</button>
        <a asp-page="Crear" class="btn btn-success">Nuevo profesor</a>
    </div>
</form>


<table class="table table-striped table-sm align-middle">
    <thead>
        <tr>
            <th>Identificación</th>
            <th>Tipo de identificación</th>
            <th>Nombre completo</th>
            <th>Email</th>
            <th>Teléfono</th>
            <th>Fecha Nacimiento</th>
            <th style="width:150px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Profesores)
        {
            <tr>
                <td>@p.NumeroIdentificacion</td>
                <td>@p.TipoIdentificacion</td>
                <td>@p.NombreCompleto</td>
                <td>@p.Email</td>
                <td>@p.Telefono</td>
                <td>@p.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-page="Editar" asp-route-id="@p.IdProfesor"
                       class="btn btn-sm btn-warning me-1">Editar</a>
                    <a asp-page="Eliminar" asp-route-id="@p.IdProfesor"
                       class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPaginas > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Pagina == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-route-Pagina="@(Model.Pagina - 1)"
                   asp-route-BuscarPor="@Model.BuscarPor"
                   asp-route-Texto="@Model.Texto">Anterior</a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">
                    Página @Model.Pagina de @Model.TotalPaginas
                </span>
            </li>

            <li class="page-item @(Model.Pagina == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-route-Pagina="@(Model.Pagina + 1)"
                   asp-route-BuscarPor="@Model.BuscarPor"
                   asp-route-Texto="@Model.Texto">Siguiente</a>
            </li>
        </ul>
    </nav>
}
