@page "{id:int}"
@model Avatar_Mod_Administración.Pages.ADM11_Profesor.EditarModel
@{
    ViewData["Title"] = "Editar Profesor";
}

<h1>Editar Profesor</h1>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

<form method="post" class="row g-3">

    <input asp-for="Profesor.IdProfesor" type="hidden" />

    <div class="col-md-4">
        <label asp-for="Profesor.NumeroIdentificacion" class="form-label"></label>
        <input asp-for="Profesor.NumeroIdentificacion" class="form-control" />
        <span asp-validation-for="Profesor.NumeroIdentificacion" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Profesor.TipoIdentificacion" class="form-label"></label>
        <select asp-for="Profesor.TipoIdentificacion" asp-items="Model.TiposIdentificacion" class="form-select"></select>
        <span asp-validation-for="Profesor.TipoIdentificacion" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Profesor.NombreCompleto" class="form-label"></label>
        <input asp-for="Profesor.NombreCompleto" class="form-control" />
        <span asp-validation-for="Profesor.NombreCompleto" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Profesor.Email" class="form-label"></label>
        <input asp-for="Profesor.Email" class="form-control" />
        <span asp-validation-for="Profesor.Email" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Profesor.Telefono" class="form-label"></label>
        <input asp-for="Profesor.Telefono" class="form-control" />
        <span asp-validation-for="Profesor.Telefono" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Profesor.FechaNacimiento" class="form-label"></label>
        <input asp-for="Profesor.FechaNacimiento" type="date" class="form-control" />
        <span asp-validation-for="Profesor.FechaNacimiento" class="text-danger"></span>
    </div>

    <div class="col-12 mt-3">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-page="Index" class="btn btn-secondary">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
