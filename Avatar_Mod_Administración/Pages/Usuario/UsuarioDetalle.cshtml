@page
@using Avatar_Mod_Administración.Entities
@model Avatar_Mod_Administración.Pages.Usuario.UsuarioDetalleModel
@{
    ViewData["Title"] = "Detalle de Usuario";
    ViewData["Breadcrumb"] = "<li class='breadcrumb-item'><a href='/Usuario/Usuarios'>Usuarios</a></li><li class='breadcrumb-item active'>Detalle de Usuario</li>";
}

@section Styles {
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
}

<div class="container usuarios-container">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card detalle-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="bi bi-person-circle"></i>
                        Detalle de Usuario
                    </h4>
                    <div class="d-flex gap-2">
                        @if (Model.Usuario != null)
                        {
                            <a asp-page="/Usuario/UsuarioEditar" asp-route-email="@Model.Usuario.Email"
                               class="btn btn-sm btn-warning text-white">
                                <i class="bi bi-pencil-fill"></i> Editar
                            </a>
                        }
                        <a asp-page="/Usuario/Usuarios" class="btn btn-sm btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Usuario == null)
                    {
                        <div class="alert alert-warning alert-usuario">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>
                                <strong>Usuario no encontrado</strong>
                                <p class="mb-0">No se encontró el usuario solicitado.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Información Principal -->
                        <h5 class="mb-4">
                            <i class="bi bi-info-circle-fill"></i>
                            Información Principal
                        </h5>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">
                                <i class="bi bi-envelope me-2 text-primary"></i>
                                Email (ID):
                            </div>
                            <div class="col-md-8">
                                <strong>@Model.Usuario.Email</strong>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">
                                <i class="bi bi-card-list me-2 text-primary"></i>
                                Tipo de Identificación:
                            </div>
                            <div class="col-md-8">@Model.Usuario.TipoIdentificacion</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">
                                <i class="bi bi-credit-card me-2 text-primary"></i>
                                Identificación:
                            </div>
                            <div class="col-md-8">@Model.Usuario.Identificacion</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">
                                <i class="bi bi-person me-2 text-primary"></i>
                                Nombre Completo:
                            </div>
                            <div class="col-md-8">@Model.Usuario.Nombre</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">
                                <i class="bi bi-shield-check me-2 text-primary"></i>
                                Rol:
                            </div>
                            <div class="col-md-8">
                                <span class="badge bg-info">
                                    <i class="bi bi-star-fill me-1"></i>
                                    @Model.Usuario.RolNombre
                                </span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">
                                <i class="bi bi-toggle-on me-2 text-primary"></i>
                                Estado:
                            </div>
                            <div class="col-md-8">
                                @if (Model.Usuario.Activo)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Inactivo
                                    </span>
                                }
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Información de Auditoría -->
                        <h5 class="mb-4">
                            <i class="bi bi-clock-history"></i>
                            Información de Auditoría
                        </h5>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">
                                <i class="bi bi-calendar-plus me-2 text-success"></i>
                                Fecha de Creación:
                            </div>
                            <div class="col-md-8">
                                @Model.Usuario.FechaCreacion.ToString("dd/MM/yyyy HH:mm:ss")
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">
                                <i class="bi bi-calendar-check me-2 text-warning"></i>
                                Última Modificación:
                            </div>
                            <div class="col-md-8">
                                @if (Model.Usuario.FechaModificacion.HasValue)
                                {
                                    @Model.Usuario.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        <i class="bi bi-dash-circle me-1"></i>
                                        Sin modificaciones
                                    </span>
                                }
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Información Adicional -->
                        <h5 class="mb-4">
                            <i class="bi bi-info-square-fill"></i>
                            Información Adicional
                        </h5>

                        <div class="row mb-3">
                            <div class="col-md-4 fw-bold">
                                <i class="bi bi-at me-2 text-primary"></i>
                                Dominio:
                            </div>
                            <div class="col-md-8">
                                @if (Model.Usuario.Email.EndsWith("@cuc.cr"))
                                {
                                    <span class="badge bg-primary">
                                        <i class="bi bi-mortarboard-fill me-1"></i>
                                        cuc.cr (Estudiante)
                                    </span>
                                }
                                else if (Model.Usuario.Email.EndsWith("@cuc.ac.cr"))
                                {
                                    <span class="badge bg-info">
                                        <i class="bi bi-book-fill me-1"></i>
                                        cuc.ac.cr (Académico)
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Tarjeta de Acciones Rápidas -->
                        <div class="alert alert-info alert-usuario mt-4">
                            <i class="bi bi-lightning-fill"></i>
                            <div>
                                <strong>Acciones Rápidas</strong>
                                <div class="mt-2 d-flex gap-2">
                                    <a asp-page="/Usuario/UsuarioEditar" asp-route-email="@Model.Usuario.Email"
                                       class="btn btn-sm btn-warning text-white">
                                        <i class="bi bi-pencil-fill"></i> Editar Usuario
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger"
                                            onclick="confirmarEliminacion('@Model.Usuario.Email')">
                                        <i class="bi bi-trash-fill"></i> Eliminar Usuario
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade modal-eliminar-usuario" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEliminarLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">
                    ¿Está seguro que desea eliminar el usuario
                    <strong id="emailEliminar"></strong>?
                </p>

                <div class="alert alert-warning alert-usuario mb-3">
                    <i class="bi bi-info-circle-fill"></i>
                    <div>
                        <strong>Importante:</strong> Esta acción eliminará permanentemente el usuario del sistema.
                    </div>
                </div>

                <p class="text-danger mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Esta acción no se puede deshacer.</strong>
                </p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar">
                    <input type="hidden" name="email" id="emailInput" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash-fill"></i> Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
}