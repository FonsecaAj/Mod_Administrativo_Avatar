@page
@model Avatar_Mod_Administración.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Avatar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-container">
        <!-- Header -->
        <div class="login-header">
            <div class="login-header-content">
                <div class="login-logo">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <h2>Sistema Avatar</h2>
                <p>Universidad CUC</p>
            </div>
        </div>

        <!-- Body -->
        <div class="login-body">
            <form method="post" class="login-form">
                <!-- Errores de validación -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                </div>

                <!-- Campo Email -->
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">
                        <i class="bi bi-envelope-fill"></i>
                        Correo Electrónico
                    </label>
                    <div class="input-group">
                        <span class="input-icon">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        <input asp-for="Input.Email"
                               class="form-control"
                               type="email"
                               placeholder="usuario@cuc.cr"
                               autocomplete="email"
                               autofocus />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Campo Contraseña -->
                <div class="mb-3">
                    <label asp-for="Input.Contrasenna" class="form-label">
                        <i class="bi bi-lock-fill"></i>
                        Contraseña
                    </label>
                    <div class="input-group">
                        <span class="input-icon">
                            <i class="bi bi-key-fill"></i>
                        </span>
                        <input asp-for="Input.Contrasenna"
                               class="form-control"
                               type="password"
                               placeholder="••••••••"
                               autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Input.Contrasenna" class="text-danger"></span>
                </div>

                <!-- Recordar Sesión -->
                <div class="mb-4 form-check">
                    <input asp-for="Input.RecordarSesion"
                           class="form-check-input"
                           type="checkbox"
                           id="recordarSesion" />
                    <label asp-for="Input.RecordarSesion"
                           class="form-check-label"
                           for="recordarSesion">
                        Recordar mi sesión
                    </label>
                </div>

                <!-- Botón de Login -->
                <button type="submit" class="btn btn-login">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Iniciar Sesión
                </button>
            </form>
        </div>

        <!-- Footer -->
        <div class="login-footer">
            <small>
                © @DateTime.Now.Year Universidad CUC. Todos los derechos reservados.
            </small>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Prevenir doble submit
        document.querySelector('.login-form').addEventListener('submit', function(e) {
            const btn = this.querySelector('.btn-login');
            if (btn.classList.contains('loading')) {
                e.preventDefault();
                return false;
            }
            btn.classList.add('loading');
            btn.innerHTML = '<span>Iniciando sesión...</span>';
        });

        // Animación en inputs
        document.querySelectorAll('.form-control').forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.style.transform = 'translateY(-2px)';
            });
            input.addEventListener('blur', function() {
                this.parentElement.style.transform = 'translateY(0)';
            });
        });
    </script>
</body>
</html>