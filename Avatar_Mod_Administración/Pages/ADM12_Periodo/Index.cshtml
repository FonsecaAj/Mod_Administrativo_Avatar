@page
@model Avatar_Mod_Administración.Pages.ADM12_Periodo.IndexModel
@{
    ViewData["Title"] = "Administrar Periodos";
}

<h1 class="mb-4">Administrar Periodos</h1>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success">@Model.Mensaje</div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

<div class="mb-3">
    <a asp-page="Crear" class="btn btn-success">Nuevo periodo</a>
</div>

@if (Model.Periodos.Any())
{
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.Periodos[0].Anno)</th>
                <th>@Html.DisplayNameFor(m => m.Periodos[0].NumeroPeriodo)</th>
                <th>@Html.DisplayNameFor(m => m.Periodos[0].FechaInicio)</th>
                <th>@Html.DisplayNameFor(m => m.Periodos[0].FechaFin)</th>
                <th>@Html.DisplayNameFor(m => m.Periodos[0].Estado)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Periodos)
            {
                <tr>
                    <td>@p.Anno</td>
                    <td>@p.NumeroPeriodo</td>
                    <td>@p.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@p.FechaFin.ToString("dd/MM/yyyy")</td>
                    <td>@p.Estado</td>
                    <td>
                        <a asp-page="Editar" asp-route-id="@p.IdPeriodo"
                           class="btn btn-sm btn-warning me-1">Editar</a>
                        <a asp-page="Eliminar" asp-route-id="@p.IdPeriodo"
                           class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay periodos registrados.</div>
}
